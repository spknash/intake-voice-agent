# LiveKit Cloud (Settings -> Keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# OpenAI (paid tier; GPT-Live is not available on Free)
OPENAI_API_KEY=

# Voice model mode: live (GPT-Live-1 + default backend) or realtime (gpt-realtime-2.1 fallback)
MODE=live

# Owner and availability
OWNER_NAME=Suhaas
OWNER_TZ=America/New_York
BOOKABLE_DAYS=Mon-Fri
BOOKABLE_HOURS=10-18
MEETING_MINUTES=30
BUFFER_MINUTES=15
MAX_PER_DAY=4
MIN_NOTICE_HOURS=12
HORIZON_DAYS=14

# Abuse limits
MAX_CALL_SECONDS=480
BOOKING_COOLDOWN_DAYS=7
# Comma-separated E.164 numbers, e.g. +15551234567,+15559876543
BLOCKLIST=

# Google Calendar
GOOGLE_CALENDAR_ID=primary
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json

# Traces
TRACES_DIR=traces

# Booking backend: calcom (default when CALCOM_USERNAME is set) or google
# Cal.com availability and booking for a public event type, e.g. https://cal.com/<username>/<slug>
CALCOM_USERNAME=
CALCOM_EVENT_SLUG=30min
# Optional; public event types need no key
CALCOM_API_KEY=

# Persona
# A GPT-Live built-in (marin, cedar, beacon, cinder, stone, vesper) or a custom voice_... id
VOICE=marin
# Optional plain-language voice description, repeated in the instructions for consistency
VOICE_STYLE=
# Optional icebreaker asked once; the answer is saved on the booking
FUN_QUESTION=Suhaas wants to know: what's your favorite animal, and why?
